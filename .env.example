# 本地开发默认值；Docker Compose 会覆盖 DATABASE_URL / DATA_DIR
ENV=dev
# 本地开发：先 createuser/createdb 建好 onefold 库；Docker Compose 中指向 db 容器
DATABASE_URL=postgresql+psycopg://onefold:onefold@127.0.0.1:5432/onefold
DATA_DIR=./data

JWT_SECRET=change-me
COOKIE_SECURE=false

API_KEY=xxxx
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash

# ── Embedding（在线 API，不在服务器加载模型）────────────
OPENROUTER_API_KEY=
EMBED_PROVIDER=openrouter
EMBED_BASE_URL=https://openrouter.ai/api/v1
# 以 OpenRouter 模型页实际 slug 为准
EMBED_MODEL=baai/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT_S=30
RERANK_ENABLED=false
RERANK_MODEL=

# ── RAG / 历史压缩 ──────────────────────────────────────
RAG_ENABLED=true
HISTORY_RAW_RUNS=4
HISTORY_COMPACT_TOKENS=6000
HISTORY_SUMMARY_MAX_TOKENS=800

GLOBAL_CONCURRENCY=8
PER_USER_CONCURRENCY=1
QUEUE_TIMEOUT_S=60
MAX_UPLOAD_MB=20

GUEST_MAX_ROUNDS=20

# ── 长期记忆 ──────────────────────────────────────────────
MEMORY_ENABLED=true
MEMORY_WORKER_CONCURRENCY=2
GUEST_MEMORY_MIN_ROUNDS=3
GUEST_MEMORY_DAILY_LIMIT=4
GUEST_MEMORY_TTL_DAYS=90

# ── 工具（联网搜索 / 网页抓取）───────────────────────────
# SEARCH_ENABLED=false 时不注册任何工具，聊天行为与未接入时完全一致
# 走 https://api.deepseek.com/v1/tools/search 与 /v1/tools/fetch，与聊天共用 API_KEY
SEARCH_ENABLED=true
SEARCH_COUNT=5
SEARCH_SNIPPET_CHARS=500
SEARCH_MIN_SCORE=1.0
FETCH_MAX_CHARS=6000
TOOL_HTTP_TIMEOUT_S=20
TOOL_HTTP_RETRIES=2
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT_S=15

# 最近 N 轮完整回放工具正文，更早的压缩成检索摘要
CONTEXT_TOOL_RESULT=6000
CONTEXT_FULL_RUNS=2

# ── 邮箱验证码 ────────────────────────────────────────────
# SMTP_HOST 留空 = dev 模式：验证码只写日志，并在接口响应里返回 dev_code
# 配好下面几项后自动真实发信（QQ/163 的 SMTP_PASSWORD 是「授权码」，不是登录密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_S=60
EMAIL_CODE_HOURLY_MAX=5
EMAIL_CODE_DAILY_MAX=10
EMAIL_CODE_MAX_ATTEMPTS=5
