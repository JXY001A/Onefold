# 本地开发默认值；Docker Compose 会覆盖 DATABASE_URL / DATA_DIR
ENV=dev
DATABASE_URL=sqlite:///./onefold.db
DATA_DIR=./data

JWT_SECRET=change-me
COOKIE_SECURE=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 家里 4080（Tailscale IP）
EMBED_BASE_URL=http://100.64.0.10:7997
EMBED_MODEL=BAAI/bge-m3
RERANK_BASE_URL=http://100.64.0.10:7997
RERANK_MODEL=BAAI/bge-reranker-v2-m3

GLOBAL_CONCURRENCY=8
PER_USER_CONCURRENCY=1
QUEUE_TIMEOUT_S=60
MAX_UPLOAD_MB=20
