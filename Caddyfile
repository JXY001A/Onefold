# 站点地址由环境变量 ONEFOLD_DOMAIN 决定（docker-compose 会注入，默认 :80）：
#   - 本地：不设 → :80，直接 http://localhost 访问
#   - 生产：.env 里设 ONEFOLD_DOMAIN=onefold.example.com → Caddy 自动申请并续期 HTTPS 证书
# 注意：这个文件要在 compose 里跑，单独 caddy run 时没有该变量会报错。
{$ONEFOLD_DOMAIN} {
    encode zstd gzip
    reverse_proxy app:8000 {
        # SSE 流式输出必须关掉缓冲，否则前端会攒一大段才一次性冒出来
        flush_interval -1
    }
}

# 可选监控子域名：先在 DNS 把 monitor 指向本机，并启用 obs profile。
# 未启用 Beszel 时访问会 502，不影响主站。
{$MONITOR_DOMAIN} {
    encode zstd gzip
    reverse_proxy beszel:8090
}
