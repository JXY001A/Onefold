# ============================================================================
# Onefold 服务器生产配置模板
#
# 用法：
#   cp server.env.example /opt/onefold/.env
#   然后填入真实密钥，不要提交这个文件
#
# 不要把本文件里的占位符直接上线；尤其是 JWT_SECRET / POSTGRES_PASSWORD。
# ============================================================================

ENV=prod
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
COOKIE_SECURE=true

# Caddy 自动 HTTPS 使用；只写域名，不带 https://
ONEFOLD_DOMAIN=onefold.example.com

# 手工执行 deploy.sh 时用于兜底镜像地址；CI 会额外传入
ONEFOLD_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/onefold

# 只在 pg_data 首次初始化时生效；之后改这里不会改库内密码
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM

# DeepSeek：聊天与搜索/抓取共用
API_KEY=CHANGE_ME_DEEPSEEK_KEY
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
SEARCH_ENABLED=true

# OpenRouter：embedding + rerank
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_KEY
EMBED_PROVIDER=openrouter
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT_S=30

RERANK_ENABLED=true
RERANK_MODEL=mongodb/rerank-3-lite

# RAG / 文档索引
RAG_ENABLED=true
RAG_TOP_K=5
RAG_LEXICAL_CANDIDATES=100
RAG_BM25_TOP=50
RAG_VECTOR_TOP=50
RAG_RRF_K=60
RAG_CHILD_CHARS=500
RAG_PARENT_CHARS=1600
INDEX_WORKER_CONCURRENCY=1
INDEX_MAX_ATTEMPTS=3
MAX_UPLOAD_MB=20

# 历史压缩
HISTORY_RAW_RUNS=4
HISTORY_COMPACT_TOKENS=6000
HISTORY_SUMMARY_MAX_TOKENS=800

# 并发与配额
GLOBAL_CONCURRENCY=8
PER_USER_CONCURRENCY=1
QUEUE_TIMEOUT_S=60
GUEST_MAX_ROUNDS=20

# 长期记忆
MEMORY_ENABLED=true
MEMORY_WORKER_CONCURRENCY=2
GUEST_MEMORY_MIN_ROUNDS=3
GUEST_MEMORY_DAILY_LIMIT=4
GUEST_MEMORY_TTL_DAYS=90

# 邮箱验证码；留空 SMTP_HOST 时验证码只写日志
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_S=60
EMAIL_CODE_HOURLY_MAX=5
EMAIL_CODE_DAILY_MAX=10
EMAIL_CODE_MAX_ATTEMPTS=5
